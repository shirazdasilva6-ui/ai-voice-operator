# Everything is optional locally. Missing keys put that integration in demo mode.
# APP_ENV=production refuses to start unless VAPI_SECRET, TWILIO_AUTH_TOKEN and DASHBOARD_TOKEN are set.
APP_ENV=development
# Protects /metrics, /calls and /vapi/assistant-config. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=

PUBLIC_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000

ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

VAPI_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_VALIDATE=true

CALENDLY_TOKEN=
CALENDLY_EVENT_TYPE_URI=https://api.calendly.com/event_types/XXXX

HUBSPOT_TOKEN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

HUMAN_COST_PER_CALL=7.00

# Auto-provisioning (Stripe checkout -> Twilio number + Vapi assistant + Resend email)
# JSON maps keyed by ISO country code: US, GB, AE, AU
STRIPE_PRICE_IDS={"US":"price_xxx","GB":"price_xxx","AE":"price_xxx","AU":"price_xxx"}
STRIPE_SETUP_PRICE_IDS={"US":"price_xxx","GB":"price_xxx","AE":"price_xxx","AU":"price_xxx"}
VAPI_API_KEY=
# GB/AU numbers need an approved Twilio regulatory bundle + address. AE numbers usually cannot be bought by API.
TWILIO_BUNDLE_SIDS={}
TWILIO_ADDRESS_SIDS={}
RESEND_API_KEY=
RESEND_FROM=Voice Operator <onboarding@yourdomain.com>
OPS_EMAIL=
